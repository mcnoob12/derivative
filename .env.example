# Copy to .env. Everything here stays on the server; nothing in this file is sent to the browser.

# --- Server-side LLM (needed for seed.py; optional for the site if visitors use local models) ---
# claude_code: runs the Claude Code CLI (`claude -p`) on the Claude subscription it is signed in to.
#   No API key. For your own use only: do not open the site to other people on this provider.
# anthropic: Anthropic API key.  openai_compat: any OpenAI-compatible endpoint (see below).
LLM_PROVIDER=claude_code
# CLAUDE_BIN=/path/to/claude     (if `claude` is not on PATH)

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Models offered in the site's model selector, first one is the default.
# Leave unset for: claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5
# LLM_MODELS=claude-haiku-5-5

# Reasoning effort for Anthropic calls (low keeps extraction and judging cheap). Empty to omit.
# LLM_EFFORT=low

# --- Any OpenAI-compatible endpoint instead, e.g. a local LM Studio or Ollama server ---
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=
# LLM_MODELS=your-model-id

# --- Seed script ---
# Optional. OpenAlex works without a key for a run this size; a free key gives you your own daily budget.
# OPENALEX_API_KEY=

# --- Storage and embeddings ---
# DERIVATIVE_DB=derivative.db
# fastembed (default, local model downloaded once) or hash (offline fallback, tests only)
# EMBEDDINGS=fastembed
